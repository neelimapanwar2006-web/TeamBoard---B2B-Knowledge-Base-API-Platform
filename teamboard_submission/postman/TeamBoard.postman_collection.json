  "item": [
    {
      "name": "01 - Register Client",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/register/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"client1\",\n  \"password\": \"securepass123\",\n  \"company_name\": \"Client One\",\n  \"email\": \"client1@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.expect(json.access).to.be.a('string');",
              "pm.expect(json.api_key).to.be.a('string');",
              "pm.collectionVariables.set('client_access_token', json.access);",
              "pm.collectionVariables.set('access_token', json.access);",
              "pm.collectionVariables.set('api_key', json.api_key);"
            ]
          }
        }
      ]
    },
